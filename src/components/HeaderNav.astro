---
import NeuronMark from './NeuronMark.astro';
interface Props {
  active?: 'home' | 'blog';
  neural?: boolean;
}

const { active = 'home', neural = false } = Astro.props;
const homeHref = (hash: string) => active === 'home' ? hash : `/${hash}`;
---
{neural ? <header class="neural-header">
  <a href={active === 'home' ? '#top' : '/'} class="neural-brand" aria-label="WCW home">
    <NeuronMark /><span>WCW</span>
  </a>
  <nav aria-label="Main navigation" class="neural-nav">
    <a href={homeHref('#about')}>About</a>
    <a href={homeHref('#research')}>Research</a>
    <a href={homeHref('#publications')}>Publications</a>
    <a href={homeHref('#awards')}>Awards</a>
    <a href={homeHref('#skills')}>Skills</a>
    <a href="/blog/" aria-current={active === 'blog' ? 'page' : undefined}>Blog ↗</a>
  </nav>
</header> : <Fragment><header id="header" class="prism-header">
  <a href="/" class="logo">Caiwei Wang</a>
</header>

<nav id="nav" class="prism-nav">
  <ul class="links">
    <li class={active === 'home' ? 'active' : undefined}><a href={homeHref('#about')}>About</a></li>
    <li><a href={homeHref('#research')}>Research</a></li>
    <li><a href={homeHref('#publications')}>Publications</a></li>
    <li><a href={homeHref('#awards')}>Awards</a></li>
    <li><a href={homeHref('#skills')}>Skills</a></li>
    <li class={active === 'blog' ? 'active' : undefined}><a href="/blog/">Blog</a></li>
  </ul>
  <ul class="icons">
    <li><a href="mailto:wanghz23826@email.com" class="icon solid fa-envelope"><span class="label">Email</span></a></li>
    <li><a href="https://github.com/" class="icon brands fa-github"><span class="label">GitHub</span></a></li>
  </ul>
</nav>
</Fragment>}
